# Copy this file to .env and fill in the values.
# Validated at startup by src/config.js; the process exits if anything is invalid.

# PostgreSQL connection string (required)
# Local:    postgresql://postgres:password@localhost:5432/foodlogger
# Railway:  provided automatically via $DATABASE_URL env variable
DATABASE_URL=postgresql://postgres:password@localhost:5432/foodlogger

# JWT secret (required, at least 32 characters; the placeholder below is too short on purpose,
# so the app refuses to start until you replace it)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Anthropic API key (required in production; optional otherwise, AI analysis then fails)
# Get one from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model for the photo analysis (default claude-sonnet-5-5; text analysis and name repair use TEXT_MODEL, below).
# Sonnet names meals far better but costs about 4x more per image analysis than Haiku; the
# per-user cap (20 analyses an hour) and the per-IP cap (60 an hour) bound that cost.
# To go back to Haiku without a code change, set (e.g. in Railway's variables):
# IMAGE_MODEL=claude-haiku-4-5-20251001
# Sonnet may also spend output tokens on thinking (billed as output), so the real cost can exceed 4x.
# Must be "claude-" followed by letters, digits, ".", "_" or "-"; the app refuses to start otherwise.
# A blank IMAGE_MODEL is an error too: delete the variable to use the default.
# After changing it, check the server log for not_found_error: a mistyped id that still fits the
# pattern makes every photo analysis return 502, and the cause appears only in the log.

# Model of the text analysis (free text meals) and of the Hebrew name-repair call of both analyses.
# Default claude-haiku-4-5-20251001. To try Claude Haiku 5.5, set (e.g. in Railway's variables):
# TEXT_MODEL=claude-haiku-5-5
# Haiku 5 gets no temperature, effort low and a larger max_tokens (adaptive thinking is on by
# default and counts against it); the rules per model family are in src/lib/modelRules.js.
# Same format as IMAGE_MODEL ("claude-" then letters, digits, ".", "_" or "-"); a blank value is
# an error: delete the variable to go back to the default. After changing it, check the server
# log for not_found_error: a mistyped id that still fits the pattern makes every text analysis
# return 502, and the cause appears only in the log.
# TEXT_MODEL=claude-haiku-4-5-20251001

# Effort of the photo analysis on Sonnet 5 (a model id starting with claude-sonnet-5): low (default),
# medium, high or off. Sonnet 5.5 spends many hidden thinking tokens (about 8-17 s per photo); low,
# medium or high sends thinking {type: between_tools} with output_config {effort}, which cuts that.
# off sends neither field: this is the rollback (IMAGE_EFFORT=off). Haiku 1-4, Opus and Fable never
# get these fields (they reject them with a 400), whatever this says; a Haiku 5 IMAGE_MODEL gets
# output_config.effort only (never thinking). Anything else (or blank) is a
# startup error.
# IMAGE_EFFORT=low

# The exact public URL of the app (scheme + host [+ port], no path; one trailing slash is
# tolerated). Every state-changing request must come from this origin (CSRF check).
# Must start with http:// or https://. Required in production; defaults to http://localhost:3000
# Production example: ORIGIN=https://food.example.com
ORIGIN=http://localhost:3000

# Server port (default 3000; Railway sets this automatically)
PORT=3000

# development | test | production (default development). Set to "production" on Railway.
NODE_ENV=development

# Number of reverse-proxy hops to trust for the client IP (rate limiting), a non-negative integer
# Default: 1 in production, 0 otherwise
# TRUST_PROXY=1

# Optional PEM CA certificate. When set, database TLS is verified against it.
# When unset, TLS verification is disabled and a startup warning is logged.
# DATABASE_CA=

# Database used by the integration tests (a separate, disposable database whose name must end in _test).
# Default: foodlogger_test on the same server as DATABASE_URL
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/foodlogger_test
