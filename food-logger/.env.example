# Copy this file to .env and fill in the values.
# Validated at startup by src/config.js; the process exits if anything is invalid.

# PostgreSQL connection string (required)
# Local:    postgresql://postgres:password@localhost:5432/foodlogger
# Railway:  provided automatically via $DATABASE_URL env variable
DATABASE_URL=postgresql://postgres:password@localhost:5432/foodlogger

# JWT secret (required, at least 32 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_string_of_32_or_more_chars

# Anthropic API key (required in production; optional otherwise, AI analysis then fails)
# Get one from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# The exact public URL of the app (scheme + host [+ port], no path; one trailing slash is
# tolerated). Every state-changing request must come from this origin (CSRF check).
# Must start with http:// or https://. Required in production; defaults to http://localhost:3000
# Production example: ORIGIN=https://food.example.com
ORIGIN=http://localhost:3000

# Server port (default 3000; Railway sets this automatically)
PORT=3000

# development | test | production (default development). Set to "production" on Railway.
NODE_ENV=development

# Number of reverse-proxy hops to trust for the client IP (rate limiting), a non-negative integer
# Default: 1 in production, 0 otherwise
# TRUST_PROXY=1

# Optional PEM CA certificate. When set, database TLS is verified against it.
# When unset, TLS verification is disabled and a startup warning is logged.
# DATABASE_CA=

# Database used by the integration tests (a separate, disposable database whose name must end in _test).
# Default: foodlogger_test on the same server as DATABASE_URL
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/foodlogger_test
